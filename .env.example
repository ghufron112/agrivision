# ==============================================================================
# PLANTSCAN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Mode Mesin Identifikasi:
# 'auto'  : Menggunakan Pl@ntNet API jika key tersedia, fallback ke Model Lokal
# 'api'   : Mewajibkan Mode A (Pl@ntNet Identification API)
# 'local' : Mewajibkan Mode B (Model Machine Learning Lokal Pl@ntNet-300K)
IDENTIFICATION_MODE=auto

# Mode A — Pl@ntNet Identification API Key
# Dapatkan API key gratis untuk riset/pengembangan di: https://my-api.plantnet.org/
# PENTING: API key HANYA dibaca oleh backend FastAPI, jangan taruh di frontend!
PLANTNET_API_KEY=

# Endpoint resmi Pl@ntNet API
PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all

# Ambang Batas Keyakinan (Confidence Threshold)
# Jika nilai probabilitas tertinggi di bawah nilai ini, sistem menampilkan peringatan "hasil belum meyakinkan"
CONFIDENCE_THRESHOLD=0.40

# Frontend URL Adapter
VITE_BACKEND_API_URL=http://127.0.0.1:8000
